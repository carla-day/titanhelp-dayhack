@inherits LayoutComponentBase

<PageTitle>TitanHelpDesk</PageTitle>

<div class="app-background">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-primary shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand text-white fw-bold" href="/">TitanHelp</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <NavLink href="/" class="nav-link text-white" Match="NavLinkMatch.All">
                                Home
                            </NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink href="/tickets" class="nav-link text-white">
                                All Tickets
                            </NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink href="/tickets/add" class="nav-link text-white">
                                Add Ticket
                            </NavLink>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="main-container">
        <Alerts />
        <div class="main-content container py-4">
            @Body
        </div>
    </div>
</div>
